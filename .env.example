# Öffentlicher Hostname des MCP-Servers (für Caddy/TLS und den Host-Check)
MCP_DOMAIN=mcp.example.com

# --- Nur für den Betrieb hinter einem vorhandenen NGINX (docker-compose.nginx.yml, siehe DEPLOY.md) ---
# Damit "docker compose ..." ohne -f die richtige Datei nimmt (und nicht die Caddy-Variante):
# COMPOSE_FILE=docker-compose.nginx.yml
# Port, an den das NGINX weiterleitet. Veröffentlicht wird er nur auf 127.0.0.1.
# MCP_PORT=8735
# true nur, wenn das NGINX X-Forwarded-For selbst setzt oder ergänzt (DEPLOY.md, Schritt 4).
# MCP_TRUST_PROXY=false

# Aufbewahrung des Audit-Logs in Tagen (0 = unbegrenzt)
GSC_AUDIT_RETENTION_DAYS=365

# Maximale Größe des Audit-Logs in MB (0 = unbegrenzt). Ist sie erreicht, liefert der Server keine Daten mehr,
# bis alte Monatsdateien ablaufen oder der Wert erhöht wird.
GSC_AUDIT_MAX_MB=100

# URL-Prüfungen je Mandant und Tag (0 = unbegrenzt). Google erlaubt je Property 2000 pro Tag.
GSC_MAX_INSPECTIONS_PER_DAY=500

# Abfragen an Google je Token und Minute (0 = unbegrenzt). Alle Mandanten teilen sich das Kontingent
# des Google-Cloud-Projekts; ein einzelner Token soll es nicht allein aufbrauchen.
GSC_MAX_CALLS_PER_MINUTE=60

# Nur für den lokalen stdio-Start (npm run start:stdio), NICHT für den Docker-Server:
# GSC_KEY_FILE=/pfad/zum/schluessel.json
# GSC_PROPERTIES=sc-domain:example.com,https://www.example.com/
